			"embedded:provider/*": ["../third_party/moddable/typings/embedded_provider/*"],
			"embedded:*": ["../third_party/moddable/typings/embedded/*"],
			"mc/*": ["../third_party/moddable/typings/mc/*"],
			"mod/*": ["../third_party/moddable/typings/mod/*"],
			"pins/*": ["../third_party/moddable/typings/pins/*"],
			"piu/*": ["../third_party/moddable/typings/piu/*"],
			"commodetto/*": ["../third_party/moddable/typings/commodetto/*"],
			"text/*": ["../third_party/moddable/typings/text/*"],
			"*": ["./*", "../third_party/moddable/typings/*"]
		}
	},
	"include": [
		"*.ts"
	]
}
