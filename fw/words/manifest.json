{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODDABLE)/examples/manifest_typings.json",
		"$(MODDABLE)/examples/manifest_piu.json",
		"$(MODULES)/files/preference",
		"../../shared/manifest.json",
		"$(MODDABLE)/modules/io/files/posix/manifest.json",
		"$(MODDABLE)/modules/io/files/esp32/manifest_sdspi.json"
	],
	"modules": {
		"*": [
			"./main",
			"./behavior",
			"./menu",
			"./settings",
			"./help",
			"./progress",
			"./wordbank",
			"./words",
			"../../shared/cardfs"
		]
	},
	"preload": [
		"behavior",
		"menu",
		"settings",
		"help",
		"progress",
		"wordbank",
		"words",
		"cardfs"
	],
	"resources": {
		"*-mask": [
			"../../shared/fonts/Word-Bold-48",
			"../../shared/fonts/Word-Bold-32",
			"../../shared/fonts/Gloss-Bold-28",
			"../../shared/fonts/Ipa-Bold-28"
		],
		"*": [
			"./wordbank.bin"
		]
	},
	"platforms": {
		"esp32": {
			"defines": {
				"sdcard": {
					"cs": 12,
					"mosi": 14,
					"miso": 39,
					"sck": 40,
					"hz": 20000000,
					"spi_port": "SPI2_HOST"
				},
				"file": {
					"root": "#/sdcard",
					"maxOpen": 8,
					"format": 0
				}
			},
			"esp32Config": {
				"CONFIG_FATFS_LFN_HEAP": "y",
				"CONFIG_FATFS_API_ENCODING_UTF_8": "y"
			}
		},
		"mac": {
			"config": {
				"files": "/sdcard-sim-sample"
			}
		},
		"lin": {
			"config": {
				"files": "/sdcard-sim-sample"
			}
		}
	}
}
